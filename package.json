{
  "name": "rag-knowledge-tree",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_USE_MOCK=true vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "bench": "vitest bench --run",
    "dev:live": "VITE_USE_MOCK=false vite",
    "test:perf": "node scripts/perf-chat-benchmark.cjs",
    "test:visual": "playwright test e2e/visual.spec.ts",
    "check:design": "node scripts/check-design.cjs --report",
    "check:design:strict": "node scripts/check-design.cjs --strict"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.0",
    "dexie": "^4.4.7",
    "katex": "^0.19.0",
    "lucide-react": "^1.57.0",
    "postprocessing": "^6.39.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/katex": "^0.16.8",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^26.1.0",
    "r3f-perf": "^7.2.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  }
}
