# RAG_TS backend (chat SSE, papers, health). `vite dev` proxies it to VITE_BACKEND_URL.
VITE_API_BASE=/api/v1
VITE_BACKEND_URL=http://localhost:3000
# true  → chat / papers / health run on the deterministic mock (no backend needed) — default
# false → call the real RAG_TS backend
VITE_USE_MOCK=true

# UTH pipeline (World 3D + crawl stream). `vite dev` proxies /pipeline/* to VITE_PIPELINE_URL/api/*.
VITE_PIPELINE_BASE=/pipeline
VITE_PIPELINE_URL=http://localhost:8000
# true  → World 3D and crawl are mocked — default (the pipeline does not serve /world/* yet)
# false → load the world and the crawl stream from the pipeline
VITE_MOCK_WORLD=true
