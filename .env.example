# Base path of the backend API (proxied to VITE_BACKEND_URL by `vite dev`)
VITE_API_BASE=/api
# true  → everything runs on the deterministic mock world (no backend needed) — default
# false → call the real NestJS backend
VITE_USE_MOCK=true
# Dev proxy target for /api
VITE_BACKEND_URL=http://localhost:8000
